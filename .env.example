VAST_API_KEY=replace_with_your_vast_api_key
RUNPOD_API_KEY=replace_with_your_runpod_api_key
TENSORDOCK_API_TOKEN=replace_with_your_tensordock_api_token
# 可选: 仅启用 Salad(config.salad.json 的 salad.enabled=true)时需要
SALAD_API_KEY=replace_with_your_salad_api_key

# 网页看板登录(原 dashboard.conf.json 已合并到这里)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=123456
DASHBOARD_PORT=8787
